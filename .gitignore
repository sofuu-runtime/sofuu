sofuu-sym

# Compiled C samples: built by `make headless-test`, never committed.
# (Three of these were committed by accident; build output is not source.)
examples/headless/c_agent
examples/headless/c_embed
examples/headless/c_rlm
examples/headless/c_embed_vec
examples/headless/c_llm

# npm package: the downloaded runtime binary is never committed. The
# shim (bin/sofuu.js) IS source and must be — the blanket `bin/` rule
# above would otherwise swallow it, so re-include it explicitly.
!npm/bin/
!npm/bin/sofuu.js
npm/bin/runtime/

# ── Prebuilt cross-compiled binaries ──────────────
# Built by scripts/cross/*.sh and shipped via GitHub Releases and
# sofuu.xyz/downloads — release artifacts, not source. They also embed
# the build machine's absolute paths, so they must never be committed.
# The README stays: it documents the exact rebuild commands.
cli/*
!cli/README.md

# ── libuv Windows CMake build cache ───────────────
# Generated by scripts/cross/build_windows_x86_64.sh (UV_BUILD points
# here). Holds *.obj/*.pdb/CMakeCache.txt with absolute local paths.
deps/libuv/build-win-x64/

# ── Tauri generated mobile/store icon sets ─────────
# `tauri icon` output for iOS/Android/Windows-Store targets this project
# does not build (bundle targets are app/dmg/nsis/deb/appimage). The
# desktop bundle only uses the 7 icons named in tauri.conf.json, and the
# rest are regenerated with `npx tauri icon` if mobile ever lands.
sofuu-desktop/src-tauri/icons/ios/
sofuu-desktop/src-tauri/icons/android/
sofuu-desktop/src-tauri/icons/Square*.png
sofuu-desktop/src-tauri/icons/StoreLogo.png
