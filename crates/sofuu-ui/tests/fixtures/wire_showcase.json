{
        "op": "replace_scene",
        "title": "Sofuu UI // JS Wire Parity",
        "theme": "light",
        "root": {
            "id": "root",
            "priority": 100,
            "visible": true,
            "width": "auto",
            "height": "auto",
            "min_width": 0,
            "min_height": 0,
            "padding": { "top": 16, "right": 16, "bottom": 16, "left": 16 },
            "kind": {
                "type": "container",
                "axis": "column",
                "align": "stretch",
                "gap": 12,
                "fold_width": null,
                "scrollable": false,
                "style": null,
                "children": [
                    {
                        "id": "hdr",
                        "kind": {
                            "type": "container",
                            "axis": "row",
                            "align": "center",
                            "gap": 10,
                            "fold_width": 720,
                            "scrollable": false,
                            "style": null,
                            "children": [
                                {
                                    "id": "title",
                                    "width": { "fill": 1.0 },
                                    "kind": { "type": "text", "content": "Wire Parity", "size": 18, "color": null, "mono": false, "wrap": false }
                                },
                                { "id": "rule", "kind": { "type": "rule", "thickness": 1, "color": null } },
                                { "id": "spacer", "kind": { "type": "spacer" } },
                                { "id": "seg", "kind": { "type": "segmented", "active": 0, "options": ["A", "B"] } },
                                { "id": "inp", "height": { "px": 34 }, "kind": { "type": "input", "value": "", "placeholder": "Type...", "tone": "neutral" } },
                                { "id": "sw", "kind": { "type": "switch", "checked": true, "label": "Live", "tone": "info" } },
                                { "id": "btn", "kind": { "type": "button", "label": "Go", "tone": "neutral" } },
                                { "id": "tog", "kind": { "type": "theme_toggle", "size": 34 } }
                            ]
                        }
                    },
                    {
                        "id": "grid",
                        "kind": {
                            "type": "grid",
                            "columns": 2,
                            "min_col_width": 220,
                            "gap": 12,
                            "style": null,
                            "children": [
                                {
                                    "id": "s1",
                                    "kind": {
                                        "type": "stat",
                                        "label": "Throughput",
                                        "value": 120.5,
                                        "value_text": null,
                                        "prefix": "",
                                        "suffix": "/s",
                                        "precision": 1,
                                        "badge": "LIVE",
                                        "delta": "+2%",
                                        "caption": null,
                                        "tone": "ok",
                                        "variant": "sparkline",
                                        "sparkline": [100, 110, 120.5],
                                        "range_bounds": null,
                                        "interactive": false
                                    }
                                },
                                {
                                    "id": "p1",
                                    "kind": {
                                        "type": "plot",
                                        "title": "Signal",
                                        "subtitle": null,
                                        "panes": [
                                            {
                                                "id": "pane0",
                                                "label": "Load %",
                                                "height_weight": 1.0,
                                                "series": [
                                                    { "id": "s_load", "name": "Load %", "kind": "area", "points": [{ "x": 0, "y": 42 }] },
                                                    { "id": "s_ohlc", "name": "Bar", "kind": "candles", "candles": [{ "x": 0, "open": 10, "high": 12, "low": 9, "close": 11 }] }
                                                ],
                                                "thresholds": [{ "value": 50, "label": "Target" }],
                                                "stacked_percent": false,
                                                "y_prefix": "",
                                                "y_suffix": "",
                                                "y_precision": 1
                                            }
                                        ],
                                        "series": [],
                                        "thresholds": [],
                                        "show_grid": true,
                                        "crosshair": true,
                                        "show_legend": true,
                                        "readout_mode": "header_bar",
                                        "stacked_percent": false,
                                        "y_prefix": "",
                                        "y_suffix": "",
                                        "y_precision": null,
                                        "empty_text": null
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "id": "tabs",
                        "kind": {
                            "type": "tabs",
                            "active": 0,
                            "items": [
                                {
                                    "label": "Queue",
                                    "child": {
                                        "id": "tbl",
                                        "kind": {
                                            "type": "table",
                                            "title": "Tasks",
                                            "columns": [{ "key": "k", "label": "Task", "width": null, "align": "left", "sortable": true }],
                                            "rows": [{ "id": "r1", "tone": null, "cells": [{ "text": "t1", "tone": "ok", "badge": true }] }],
                                            "selected_row": "r1",
                                            "row_height": 32,
                                            "striped": true,
                                            "empty_text": null
                                        }
                                    }
                                },
                                {
                                    "label": "Stream",
                                    "child": {
                                        "id": "feed",
                                        "kind": {
                                            "type": "feed",
                                            "title": "Stream",
                                            "items": [{ "id": "f1", "time": "00:01", "badge": "OK", "tone": "ok", "title": "Init", "body": null }],
                                            "max_items": 200,
                                            "newest_first": true,
                                            "empty_text": null
                                        }
                                    }
                                },
                                {
                                    "label": "DAG",
                                    "child": {
                                        "id": "dag",
                                        "kind": {
                                            "type": "graph",
                                            "title": "DAG",
                                            "nodes": [{ "id": "n1", "label": "Start", "subtitle": null, "tone": "info" }],
                                            "edges": [],
                                            "selected_node": null,
                                            "empty_text": null
                                        }
                                    }
                                },
                                {
                                    "label": "Code",
                                    "child": {
                                        "id": "code",
                                        "kind": {
                                            "type": "code_text",
                                            "title": "gate.js",
                                            "language": "JS",
                                            "content": "return 1;",
                                            "show_line_numbers": true,
                                            "highlights": [{ "line": 1, "tone": "info" }]
                                        }
                                    }
                                }
                            ]
                        }
                    }
                ]
            }
        }
    }