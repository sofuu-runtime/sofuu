# /etc/sofuu/agent.env — environment for sofuu-agent.service
#
# systemd EnvironmentFile format: KEY=VALUE, one per line. A '#' only starts a
# comment at the beginning of a line — there are no inline comments here,
# because systemd would keep them as part of the value.
#
# install.sh writes this file (0600) on first install; edit it in place after
# that. The service is killed and restarted by `systemctl restart sofuu-agent`
# after a change — the file is not re-read live.

# Where the artifact's embedded brain is materialised. Must be a path the
# `sofuu` service user can write. Only meaningful for the compiled shape; the
# development shape opens SOFUU_DEVICE_BRAIN instead.
SOFUU_EMBEDDED_BRAIN=/var/lib/sofuu/ambient.brain.qtsq

# Development shape only: the brain file `sofuu run agent.js` opens. Ignored
# when an embedded brain is present.
SOFUU_DEVICE_BRAIN=/var/lib/sofuu/device.brain.qtsq
SOFUU_DEVICE_DIM=768

# Identity carried in the first-launch seed record.
SOFUU_DEVICE_NAME=ambient-01
SOFUU_DEVICE_SITE=bench

# How often the device appends a sensor record, in milliseconds.
SOFUU_READING_INTERVAL_MS=60000

# Fleet key override (64 hex chars). Leave unset on a single device: the
# machine-local key at $HOME/.sofuu/brain.key is generated on first write and
# never leaves the box. Set it ONLY when several devices must open the same
# brain, and then treat it as a secret (this file is 0600).
#SOFUU_BRAIN_KEY=
