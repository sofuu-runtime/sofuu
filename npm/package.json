{
  "name": "sofuu",
  "version": "0.3.0-beta.2",
  "description": "Sofuu \u2014 a general-purpose runtime for AI, built to run anywhere from servers to smart devices.",
  "keywords": [
    "ai",
    "agent",
    "agents",
    "llm",
    "mcp",
    "embeddings",
    "vector",
    "offline",
    "on-device",
    "runtime",
    "quickjs",
    "typescript"
  ],
  "homepage": "https://sofuu.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sofuu-runtime/sofuu.git"
  },
  "bugs": {
    "url": "https://github.com/sofuu-runtime/sofuu/issues"
  },
  "license": "MIT",
  "author": "Haruhito <hello@sofuu.xyz>",
  "type": "commonjs",
  "types": "sofuu.d.ts",
  "bin": {
    "sofuu": "bin/sofuu.js"
  },
  "files": [
    "bin/sofuu.js",
    "install.js",
    "sofuu.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "node -e \"const f=require('fs'),p=require('path');for(const n of ['LICENSE','NOTICE','sofuu.d.ts'])f.copyFileSync(p.join(__dirname,'..',n),p.join(__dirname,n))\"",
    "postinstall": "node install.js",
    "test": "node install.js --verify-only"
  },
  "engines": {
    "node": ">=16"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
