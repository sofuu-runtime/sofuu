{
  "name": "sofuu-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "build": "vite build && electron-builder",
    "package": "electron-builder -m",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.sofuu.desktop",
    "mac": {
      "target": "dmg"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../sofuu",
        "to": "sofuu"
      },
      {
        "from": "sofuu-bridge.js",
        "to": "sofuu-bridge.js"
      }
    ]
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "lucide-react": "^1.8.0",
    "vite": "^8.0.9"
  }
}
