{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sofuu",
  "version": "0.1.0",
  "identifier": "com.sofuu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sofuu",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "backgroundColor": { "red": 255, "green": 251, "blue": 240, "alpha": 0 },
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Sofuu — the AI-native JS runtime, desktop edition",
    "longDescription": "Sofuu Desktop links the full sofuu runtime in-process: streaming agent chat, coding tools with approval prompts, session resume, and macOS-native integration.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
