mkdirrecursive6plugin init requires a name>refusing to overwrite existing scaffolded 8next: sofuu plugin validate –(import { defineProvider } from 'sofuu';
export default defineProvider({
  name: 'llamacpp',
  kind: 'llamacpp',
  baseUrl: (typeof process !== 'undefined' && process.env && process.env.LLAMACPP_HOST) || 'http://127.0.0.1:8080',
  model: 'default',
  description: 'Production llama.cpp inference bridge (/v1/chat/completions)',
  async complete(req, ctx) {
    var msgs = req.messages || (req.prompt ? [{ role: 'user', content: req.prompt }] : []);
    if (req.system) msgs = [{ role: 'system', content: req.system }].concat(msgs);
    var res = await ctx.fetch((this.baseUrl || 'http://127.0.0.1:8080') + '/v1/chat/completions', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ model: req.model || this.model, messages: msgs, stream: false, temperature: req.temperature, max_tokens: req.maxTokens })
    });
    if (!res || !res.ok) throw new Error('llama.cpp HTTP ' + (res ? res.status : 0));
    var d = await res.json();
    var c = (d.choices && d.choices[0]) || {};
    var m = c.message || {};
    return { text: m.content || '', model: d.model || req.model, finishReason: c.finish_reason };
  },
  async stream(req, ctx, onEvent) {
    var msgs = req.messages || (req.prompt ? [{ role: 'user', content: req.prompt }] : []);
    if (req.system) msgs = [{ role: 'system', content: req.system }].concat(msgs);
    var res = await ctx.fetch((this.baseUrl || 'http://127.0.0.1:8080') + '/v1/chat/completions', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ model: req.model || this.model, messages: msgs, stream: true })
    });
    if (!res || !res.ok) throw new Error('llama.cpp HTTP ' + (res ? res.status : 0));
    var text = await res.text();
    var lines = (text || '').split('\n');
    var acc = { text: '' };
    for (var i = 0; i < lines.length; i++) {
      var l = lines[i].trim();
      if (!l.startsWith('data:') || l.slice(5).trim() === '[DONE]') continue;
      try {
        var ch = JSON.parse(l.slice(5).trim());
        var d = (ch.choices && ch.choices[0] && ch.choices[0].delta) || {};
        if (d.content) { acc.text += d.content; onEvent({ type: 'text', text: d.content }); }
      } catch (e) { /* a keep-alive comment that will not parse is skipped. */ }
    }
    onEvent({ type: 'done' });
    return acc;
  },
  async health() {
    try { var r = await fetch((this.baseUrl || 'http://127.0.0.1:8080') + '/health'); return { ok: Boolean(r && r.ok) }; }
    catch (e) { return { ok: false, error: String(e) }; }
  }
});
º#import { defineProvider } from 'sofuu';
export default defineProvider({
  name: 'ollama',
  kind: 'ollama',
  baseUrl: (typeof process !== 'undefined' && process.env && process.env.OLLAMA_HOST) || 'http://127.0.0.1:11434',
  model: 'llama3.2',
  description: 'Local Ollama bridge (/api/chat)',
  async complete(req, ctx) {
    var msgs = req.messages || (req.prompt ? [{ role: 'user', content: req.prompt }] : []);
    if (req.system) msgs = [{ role: 'system', content: req.system }].concat(msgs);
    var res = await ctx.fetch((this.baseUrl || 'http://127.0.0.1:11434') + '/api/chat', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ model: req.model || this.model, messages: msgs, stream: false })
    });
    if (!res || !res.ok) throw new Error('Ollama HTTP ' + (res ? res.status : 0));
    var d = await res.json();
    return { text: (d.message && d.message.content) || '', model: d.model || req.model };
  },
  async stream(req, ctx, onEvent) {
    var msgs = req.messages || (req.prompt ? [{ role: 'user', content: req.prompt }] : []);
    if (req.system) msgs = [{ role: 'system', content: req.system }].concat(msgs);
    var res = await ctx.fetch((this.baseUrl || 'http://127.0.0.1:11434') + '/api/chat', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ model: req.model || this.model, messages: msgs, stream: true })
    });
    if (!res || !res.ok) throw new Error('Ollama HTTP ' + (res ? res.status : 0));
    var text = await res.text();
    var lines = (text || '').split('\n');
    var acc = { text: '' };
    for (var i = 0; i < lines.length; i++) {
      var l = lines[i].trim();
      if (!l) continue;
      try {
        var ch = JSON.parse(l);
        if (ch.message && ch.message.content) { acc.text += ch.message.content; onEvent({ type: 'text', text: ch.message.content }); }
      } catch (e) { /* a keep-alive comment that will not parse is skipped. */ }
    }
    onEvent({ type: 'done' });
    return acc;
  },
  async health() {
    try { var r = await fetch((this.baseUrl || 'http://127.0.0.1:11434') + '/api/tags'); return { ok: Boolean(r && r.ok) }; }
    catch (e) { return { ok: false, error: String(e) }; }
  }
});
