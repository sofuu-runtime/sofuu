mkdirrecursive6plugin init requires a name>refusing to overwrite existing scaffolded 8next: sofuu plugin validate –(import { defineProvider } from 'sofuu';
export default defineProvider({
  name: 'llamacpp',
  kind: 'llamacpp',
  baseUrl: (typeof process !== 'undefined' && process.env && process.env.LLAMACPP_HOST) || 'http://127.0.0.1:8080',
  model: 'default',
  description: 'Production llama.cpp inference bridge (/v1/chat/completions)',
  async complete(req, ctx) {
    var msgs = req.messages || (req.prompt ? [{ role: 'user', content: req.prompt }] : []);
    if (req.system) msgs = [{ role: 'system', content: req.system }].concat(msgs);
    var res = await ctx.fetch((this.baseUrl || 'http://127.0.0.1:8080') + '/v1/chat/completions', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ model: req.model || this.model, messages: msgs, stream: false, temperature: req.temperature, max_tokens: req.maxTokens })
    });
    if (!res || !res.ok) throw new Error('llama.cpp HTTP ' + (res ? res.status : 0));
    var d = await res.json();
    var c = (d.choices && d.choices[0]) || {};
    var m = c.message || {};
    return { text: m.content || '', model: d.model || req.model, finishReason: c.finish_reason };
  },
  async stream(req, ctx, onEvent) {
    var msgs = req.messages || (req.prompt ? [{ role: 'user', content: req.prompt }] : []);
    if (req.system) msgs = [{ role: 'system', content: req.system }].concat(msgs);
    var res = await ctx.fetch((this.baseUrl || 'http://127.0.0.1:8080') + '/v1/chat/completions', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ model: req.model || this.model, messages: msgs, stream: true })
    });
    if (!res || !res.ok) throw new Error('llama.cpp HTTP ' + (res ? res.status : 0));
    var text = await res.text();
    var lines = (text || '').split('\n');
    var acc = { text: '' };
    for (var i = 0; i < lines.length; i++) {
      var l = lines[i].trim();
      if (!l.startsWith('data:') || l.slice(5).trim() === '[DONE]') continue;
      try {
        var ch = JSON.parse(l.slice(5).trim());
        var d = (ch.choices && ch.choices[0] && ch.choices[0].delta) || {};
        if (d.content) { acc.text += d.content; onEvent({ type: 'text', text: d.content }); }
      } catch (e) { /* a keep-alive comment that will not parse is skipped. */ }
    }
    onEvent({ type: 'done' });
    return acc;
  },
  async health() {
    try { var r = await fetch((this.baseUrl || 'http://127.0.0.1:8080') + '/health'); return { ok: Boolean(r && r.ok) }; }
    catch (e) { return { ok: false, error: String(e) }; }
  }
});
º#import { defineProvider } from 'sofuu';
export default defineProvider({
  name: 'ollama',
  kind: 'ollama',
  baseUrl: (typeof process !== 'undefined' && process.env && process.env.OLLAMA_HOST) || 'http://127.0.0.1:11434',
  model: 'llama3.2',
  description: 'Local Ollama bridge (/api/chat)',
  async complete(req, ctx) {
    var msgs = req.messages || (req.prompt ? [{ role: 'user', content: req.prompt }] : []);
    if (req.system) msgs = [{ role: 'system', content: req.system }].concat(msgs);
    var res = await ctx.fetch((this.baseUrl || 'http://127.0.0.1:11434') + '/api/chat', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ model: req.model || this.model, messages: msgs, stream: false })
    });
    if (!res || !res.ok) throw new Error('Ollama HTTP ' + (res ? res.status : 0));
    var d = await res.json();
    return { text: (d.message && d.message.content) || '', model: d.model || req.model };
  },
  async stream(req, ctx, onEvent) {
    var msgs = req.messages || (req.prompt ? [{ role: 'user', content: req.prompt }] : []);
    if (req.system) msgs = [{ role: 'system', content: req.system }].concat(msgs);
    var res = await ctx.fetch((this.baseUrl || 'http://127.0.0.1:11434') + '/api/chat', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ model: req.model || this.model, messages: msgs, stream: true })
    });
    if (!res || !res.ok) throw new Error('Ollama HTTP ' + (res ? res.status : 0));
    var text = await res.text();
    var lines = (text || '').split('\n');
    var acc = { text: '' };
    for (var i = 0; i < lines.length; i++) {
      var l = lines[i].trim();
      if (!l) continue;
      try {
        var ch = JSON.parse(l);
        if (ch.message && ch.message.content) { acc.text += ch.message.content; onEvent({ type: 'text', text: ch.message.content }); }
      } catch (e) { /* a keep-alive comment that will not parse is skipped. */ }
    }
    onEvent({ type: 'done' });
    return acc;
  },
  async health() {
    try { var r = await fetch((this.baseUrl || 'http://127.0.0.1:11434') + '/api/tags'); return { ok: Boolean(r && r.ok) }; }
    catch (e) { return { ok: false, error: String(e) }; }
  }
});
Šimport { defineTool, z } from 'sofuu';

export default defineTool({
  name: 'firecrawl_scrape',
  description: 'Scrape and extract clean markdown content from any web page using Firecrawl API',
  permissions: { net: ['api.firecrawl.dev'] },
  schema: z.object({
    url: z.string().describe('The URL to scrape and convert to markdown'),
    formats: z.array(z.string()).default(['markdown']).describe('Formats to extract (e.g. markdown, html)')
  }),
  timeoutMs: 15000,
  requiresApproval: false,
  async run(args, ctx) {
    var apiKey = (typeof process !== 'undefined' && process.env && process.env.FIRECRAWL_API_KEY) || '';
    if (!apiKey) {
      throw new Error('FIRECRAWL_API_KEY environment variable is required to use Firecrawl');
    }
    var res = await ctx.fetch('https://api.firecrawl.dev/v1/scrape', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + apiKey
      },
      body: JSON.stringify({ url: args.url, formats: args.formats || ['markdown'] })
    });
    if (!res || !res.ok) {
      var errText = res ? await res.text() : 'network failure';
      throw new Error('Firecrawl API error (HTTP ' + (res ? res.status : 0) + '): ' + errText);
    }
    var data = await res.json();
    return {
      url: args.url,
      markdown: (data.data && data.data.markdown) || data.markdown || '',
      title: (data.data && data.data.metadata && data.data.metadata.title) || ''
    };
  }
});
¢import { defineTool, z } from 'sofuu';

export default defineTool({
  name: 'github_repo',
  description: 'Fetch real-time stats and metadata for a public GitHub repository',
  permissions: { net: ['api.github.com'] },
  schema: z.object({
    owner: z.string().describe('Repository owner (e.g. facebook)'),
    repo: z.string().describe('Repository name (e.g. react)')
  }),
  timeoutMs: 8000,
  async run(args, ctx) {
    var url = 'https://api.github.com/repos/' + encodeURIComponent(args.owner) + '/' + encodeURIComponent(args.repo);
    var res = await ctx.fetch(url, {
      headers: {
        'Accept': 'application/vnd.github.v3+json',
        'User-Agent': 'sofuu-plugin-github/0.3'
      }
    });
    if (!res || !res.ok) {
      throw new Error('GitHub API error (HTTP ' + (res ? res.status : 'unknown') + ')');
    }
    var d = await res.json();
    return {
      fullName: d.full_name,
      description: d.description,
      stars: d.stargazers_count,
      forks: d.forks_count,
      openIssues: d.open_issues_count,
      license: d.license ? d.license.spdx_id : 'none'
    };
  }
});
